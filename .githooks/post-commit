#!/bin/sh
# Tags every commit on main as v0.1.<number of commits> (annotated, so that
# `git push` with push.followTags sends it). The Forgejo push mirror carries the
# tag to GitHub, where .github/workflows/build.yml builds the release.
# Enable once per clone:
#   git config core.hooksPath .githooks && git config push.followTags true
[ "$(git rev-parse --abbrev-ref HEAD)" = main ] || exit 0
git tag --points-at HEAD | grep -q '^v' && exit 0
tag="v0.1.$(git rev-list --count HEAD)"
git tag -a "$tag" -m "$tag" && echo "Tagged $tag"
