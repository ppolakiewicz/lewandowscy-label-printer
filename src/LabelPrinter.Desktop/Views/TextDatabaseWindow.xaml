<Window x:Class="LabelPrinter.Desktop.Views.TextDatabaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Baza tekstów"
        Width="1040" Height="660" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <!-- Status bar -->
        <Border x:Name="StatusBorder" DockPanel.Dock="Bottom" BorderBrush="#FFD0D0D0" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="12,12,12,0">
            <!-- Search -->
            <DockPanel>
                <Label Content="_Szukaj:" Target="{Binding ElementName=FilterBox}" VerticalAlignment="Center" FontSize="14" />
                <Button DockPanel.Dock="Right" Content="Wyczyść" Padding="10,2" Margin="6,0,0,0" Click="ClearFilter_Click" />
                <TextBox x:Name="FilterBox" FontSize="16" Padding="4,2" VerticalContentAlignment="Center"
                         ToolTip="Fragment tekstu (wielkość liter i polskie znaki nie mają znaczenia). ↓ przechodzi do listy." />
            </DockPanel>

            <!-- Actions -->
            <WrapPanel Margin="0,10,0,6">
                <WrapPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="0,0,6,6" />
                        <Setter Property="Padding" Value="12,4" />
                    </Style>
                </WrapPanel.Resources>
                <Button Content="_Dodaj…" Click="Add_Click" ToolTip="Nowy tekst (Ctrl+N)" />
                <Button x:Name="EditButton" Content="_Edytuj…" Click="Edit_Click" ToolTip="Popraw zaznaczony tekst (F2, Enter, dwuklik)" />
                <Button x:Name="DeleteButton" Content="_Usuń" Click="Delete_Click" ToolTip="Usuń zaznaczone teksty (Delete)" />
                <Button x:Name="UseButton" Content="Użyj w _oknie głównym" FontWeight="SemiBold" Click="Use_Click"
                        ToolTip="Wstaw zaznaczony tekst do okna głównego" />
                <Separator Width="12" Visibility="Hidden" />
                <Button x:Name="PrintButton" Content="Dru_kuj" Click="Print_Click" ToolTip="Drukuj zaznaczone teksty (Ctrl+P)" />
                <TextBlock Text="kopii:" VerticalAlignment="Center" Margin="0,0,4,6" />
                <TextBox x:Name="CopiesBox" Width="44" Margin="0,0,6,6" TextAlignment="Center" VerticalContentAlignment="Center"
                         MaxLength="3" ToolTip="Liczba kopii każdego zaznaczonego tekstu (1–999)" />
                <Separator Width="12" Visibility="Hidden" />
                <Button Content="_Import CSV…" Click="Import_Click" ToolTip="Dopisz teksty z pliku CSV (np. z Excela)" />
                <Button Content="Eks_port CSV…" Click="Export_Click" ToolTip="Zapisz całą bazę do pliku CSV (otwiera się w Excelu)" />
            </WrapPanel>
        </StackPanel>

        <DataGrid x:Name="LabelsGrid" Margin="12,0,12,12"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserResizeRows="False" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFE6E6E6" FontSize="14" RowHeight="28"
                  SelectionChanged="LabelsGrid_SelectionChanged" MouseDoubleClick="LabelsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tekst" Binding="{Binding Display}" Width="*" SortMemberPath="Display" />
                <DataGridTextColumn Header="Tryb" Binding="{Binding ModeName}" Width="Auto" SortMemberPath="ModeName" />
                <DataGridTextColumn Header="Użyć" Binding="{Binding UseCount}" Width="Auto" SortMemberPath="UseCount">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Margin" Value="4,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Ostatnio drukowany" Binding="{Binding LastUsedText}" Width="Auto" SortMemberPath="LastUsedSort" />
                <DataGridTextColumn Header="Notatka" Binding="{Binding Note}" Width="220" SortMemberPath="Note" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
