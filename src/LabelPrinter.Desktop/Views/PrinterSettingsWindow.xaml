<Window x:Class="LabelPrinter.Desktop.Views.PrinterSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ustawienia drukarki"
        Width="860" Height="735" MinWidth="760" MinHeight="695"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Zamknij" Padding="20,5" IsCancel="True" />
            <Button DockPanel.Dock="Right" Content="_Zapisz ustawienia" Padding="16,5" Margin="0,0,8,0" FontWeight="SemiBold"
                    Click="Save_Click" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <GroupBox Header="Drukarka" Padding="8">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Odśwież" Margin="6,0,0,0" Padding="10,2"
                                    Click="RefreshPrinters_Click" />
                            <ComboBox x:Name="PrinterCombo" SelectionChanged="Settings_SelectionChanged" />
                        </DockPanel>
                        <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                                   Text="Drukarka Zebra ma być dodana w Windows jako „Generic / Text Only” na porcie USB (np. USB001)." />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Etykieta i kalibracja" Padding="8" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="0,3" />
                            </Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Margin" Value="0,3" />
                            </Style>
                        </Grid.Resources>

                        <TextBlock Grid.Row="0" Text="Szerokość etykiety (mm)" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="WidthBox" TextChanged="Settings_TextChanged" />

                        <TextBlock Grid.Row="1" Text="Szerokość druku drukarki (mm)" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="PrintWidthBox" TextChanged="Settings_TextChanged"
                                 ToolTip="Pełna szerokość głowicy. LP2844 i ZT231: 104 mm." />

                        <TextBlock Grid.Row="2" Text="Prowadzenie rolki" />
                        <!-- Items are in the order of the RollGuide enum. -->
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="RollGuideCombo" Margin="0,3"
                                  SelectionChanged="Settings_SelectionChanged"
                                  ToolTip="Gdzie drukarka trzyma rolkę. LP2844: środek. ZT231: krawędź – stronę wskaże wydruk testowy.">
                            <ComboBoxItem Content="Środek głowicy" />
                            <ComboBoxItem Content="Lewa krawędź głowicy" />
                            <ComboBoxItem Content="Prawa krawędź głowicy" />
                        </ComboBox>

                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" x:Name="PrintAreaText" FontSize="11" Foreground="Gray"
                                   TextWrapping="Wrap" Margin="0,0,0,4" />

                        <TextBlock Grid.Row="4" Text="Wysokość etykiety (mm)" />
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="HeightBox" TextChanged="Settings_TextChanged" />

                        <TextBlock Grid.Row="5" Text="Przerwa między etykietami (mm)" />
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="GapBox" TextChanged="Settings_TextChanged" />

                        <TextBlock Grid.Row="6" Text="Przesunięcie w poziomie (mm)" />
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="OffsetXBox" TextChanged="Settings_TextChanged" />

                        <TextBlock Grid.Row="7" Text="Przesunięcie w pionie (mm)" />
                        <TextBox Grid.Row="7" Grid.Column="1" x:Name="OffsetYBox" TextChanged="Settings_TextChanged" />

                        <TextBlock Grid.Row="8" Text="Ciemność druku (0–15)" />
                        <DockPanel Grid.Row="8" Grid.Column="1" Margin="0,3">
                            <TextBlock x:Name="DarknessValue" DockPanel.Dock="Right" Width="24" TextAlignment="Right" Margin="0" />
                            <Slider x:Name="DarknessSlider" Minimum="0" Maximum="15" TickFrequency="1"
                                    IsSnapToTickEnabled="True" ValueChanged="DarknessSlider_ValueChanged" />
                        </DockPanel>

                        <TextBlock Grid.Row="9" Text="Prędkość (1–4)" />
                        <ComboBox Grid.Row="9" Grid.Column="1" x:Name="SpeedCombo" Margin="0,3"
                                  SelectionChanged="Settings_SelectionChanged" />

                        <CheckBox Grid.Row="10" Grid.ColumnSpan="2" x:Name="TopFirstCheck" Margin="0,6,0,3"
                                  Content="Drukuj od góry etykiety (ZT)" Click="Settings_Click" />

                        <CheckBox Grid.Row="11" Grid.ColumnSpan="2" x:Name="InvertCheck" Margin="0,3"
                                  Content="Odwróć grafikę (tylko gdy test wychodzi w negatywie)" Click="Settings_Click" />
                    </Grid>
                </GroupBox>

                <WrapPanel Margin="0,10,0,0">
                    <WrapPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Margin" Value="0,0,8,8" />
                            <Setter Property="Padding" Value="12,5" />
                        </Style>
                    </WrapPanel.Resources>
                    <Button Content="_Wydruk testowy" FontWeight="Bold" Click="TestPrint_Click" />
                    <Button Content="_Auto-kalibracja czujnika" Click="AutoSense_Click"
                            ToolTip="Drukarka sama zmierzy długość etykiety i przerwy (wysunie kilka etykiet)." />
                    <Button Content="_Konfiguracja drukarki" Click="PrinterConfiguration_Click"
                            ToolTip="Drukarka wydrukuje swoje ustawienia." />
                    <Button Content="Zapisz test do _pliku…" Click="SaveTestFile_Click"
                            ToolTip="Zapisuje polecenia EPL wydruku testowego do pliku (diagnostyka)." />
                </WrapPanel>
            </StackPanel>

            <GroupBox Grid.Column="1" Header="Podgląd wydruku testowego" Padding="8" Margin="12,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                               Text="Ramka powinna wypaść na krawędzi etykiety, a czarny kwadrat w prawym dolnym rogu. Napisy drukuje sama drukarka, więc nie ma ich w podglądzie. Wydruk testowy i auto-kalibracja zapisują też ustawienia." />
                    <Border Background="White" BorderBrush="LightGray" BorderThickness="1" Padding="10"
                            VerticalAlignment="Top">
                        <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
