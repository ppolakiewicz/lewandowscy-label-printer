<Window x:Class="LabelPrinter.Desktop.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Etykiety – pomoc"
        Width="640" Height="640" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Zamknij" Padding="20,4" IsCancel="True" IsDefault="True" Click="Close_Click" />
            <Button DockPanel.Dock="Left" Content="Otwórz folder z danymi" Padding="12,4" Click="DataFolder_Click" />
            <TextBlock x:Name="VersionText" Margin="12,0" VerticalAlignment="Center" Foreground="{StaticResource HintBrush}" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel.Resources>
                    <Style x:Key="Heading" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="16" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Margin" Value="0,12,0,4" />
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="Margin" Value="0,2" />
                    </Style>
                </StackPanel.Resources>

                <TextBlock Style="{StaticResource Heading}" Margin="0,0,0,4" Text="Drukowanie etykiety" />
                <TextBlock Text="1. Wpisz tekst w polu „Tekst etykiety”. Podgląd po prawej pokazuje dokładnie to, co zostanie wydrukowane." />
                <TextBlock Text="2. „Jedna linijka” – tekst sam się zawija (po spacji, „-” lub „_”) na maksymalnie 3 linijki. „Osobne linijki” – wpisujesz 2 lub 3 linijki osobno." />
                <TextBlock Text="3. Ustaw wyrównanie, pogrubienie, czcionkę i rozmiar (najlepiej „Automatyczny” – największy, który się zmieści)." />
                <TextBlock Text="4. Wpisz liczbę kopii i naciśnij Enter (w polu tekstu), Ctrl+P albo przycisk „Drukuj”. Po wydruku liczba kopii wraca do 1, a tekst zostaje zaznaczony – można od razu pisać następny." />
                <TextBlock Text="Jeśli tekst się nie mieści, pod podglądem pojawi się czerwone ostrzeżenie, a program zapyta przed drukowaniem." />

                <TextBlock Style="{StaticResource Heading}" Text="Podpowiedzi" />
                <TextBlock Text="Każdy wydrukowany tekst jest zapamiętywany w bazie. Podczas pisania pod polem pojawia się lista podobnych tekstów (wielkość liter i polskie znaki nie mają znaczenia)." />
                <TextBlock Text="• ↓ / ↑ – wybór z listy (↓ otwiera listę także przy pustym polu: najczęściej używane teksty)" />
                <TextBlock Text="• Enter lub Tab – wstawia wybrany tekst razem z jego ustawieniami (tryb, wyrównanie, czcionka, rozmiar)" />
                <TextBlock Text="• Esc – zamyka listę" />
                <TextBlock Text="Gdy lista jest otwarta, Enter nigdy nie drukuje: wstawia zaznaczony tekst albo tylko zamyka listę. Drugie naciśnięcie Enter drukuje." />

                <TextBlock Style="{StaticResource Heading}" Text="Baza tekstów (Ctrl+B)" />
                <TextBlock Text="Lista wszystkich zapamiętanych tekstów z liczbą użyć i datą ostatniego wydruku. Można wyszukiwać, dodawać, poprawiać (F2 lub Enter), usuwać (Delete), drukować (Ctrl+P) i wstawiać tekst do okna głównego („Użyj”)." />
                <TextBlock Text="Import i eksport CSV: plik otwiera się w Excelu (separator „;”). Import dopisuje nowe teksty i aktualizuje istniejące – nic nie jest kasowane." />

                <TextBlock Style="{StaticResource Heading}" Text="Ustawienia drukarki" />
                <TextBlock Text="Wybór drukarki, rozmiar etykiety, przesunięcia, ciemność i prędkość druku. „Wydruk testowy” drukuje ramkę na krawędzi etykiety – jeśli jest przesunięta, popraw „Przesunięcie” w milimetrach." />

                <TextBlock Style="{StaticResource Heading}" Text="Skróty klawiszowe" />
                <TextBlock Text="Enter – drukuj (gdy lista podpowiedzi jest zamknięta) · Ctrl+P – drukuj · Ctrl+B – baza tekstów · F1 – pomoc · Alt+J / Alt+O – tryb tekstu · ↑ ↓ w polu kopii – zmiana liczby kopii" />

                <TextBlock Style="{StaticResource Heading}" Text="Kopia zapasowa" />
                <TextBlock x:Name="DataText" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
