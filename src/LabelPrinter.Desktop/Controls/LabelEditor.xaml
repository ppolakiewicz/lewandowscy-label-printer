<UserControl x:Class="LabelPrinter.Desktop.Controls.LabelEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="OptionLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,12,6" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,18,0" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Layout mode -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="AutoModeRadio" Content="_Jedna linijka (zawijanie automatyczne)" />
            <RadioButton x:Name="ManualModeRadio" Content="_Osobne linijki" />
        </StackPanel>

        <!-- Text: one box (auto) or three boxes (manual) -->
        <Grid>
            <TextBox x:Name="AutoTextBox" Style="{StaticResource InputBox}"
                     ToolTip="Tekst etykiety. Zawija się sam po spacji, „-” lub „_” (do 3 linijek)." />
            <Grid x:Name="ManualPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="1." Style="{StaticResource OptionLabel}" Margin="0,0,8,6" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="Line1Box" Style="{StaticResource InputBox}" ToolTip="Pierwsza linijka" />
                <TextBlock Grid.Row="1" Text="2." Style="{StaticResource OptionLabel}" Margin="0,0,8,6" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="Line2Box" Style="{StaticResource InputBox}" ToolTip="Druga linijka" />
                <TextBlock Grid.Row="2" Text="3." Style="{StaticResource OptionLabel}" Margin="0,0,8,6" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="Line3Box" Style="{StaticResource InputBox}" ToolTip="Trzecia linijka (może zostać pusta)" />
            </Grid>
        </Grid>

        <TextBlock x:Name="HintText" Foreground="{StaticResource HintBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

        <!-- Options -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Wyrównanie:" Style="{StaticResource OptionLabel}" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                <RadioButton x:Name="CenterRadio" Content="Do środka" />
                <RadioButton x:Name="LeftRadio" Content="Do lewej" />
                <CheckBox x:Name="BoldCheck" Content="_Pogrubienie" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="Bold" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="Czcionka:" Style="{StaticResource OptionLabel}" />
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FontCombo" Width="220" HorizontalAlignment="Left" Margin="0,4">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="15" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="2" Text="Rozmiar:" Style="{StaticResource OptionLabel}" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                <RadioButton x:Name="AutoSizeRadio" Content="Automatyczny" Margin="0,0,4,0" />
                <TextBlock x:Name="AutoSizeInfo" VerticalAlignment="Center" Foreground="{StaticResource HintBrush}" Margin="0,0,18,0" />
                <RadioButton x:Name="FixedSizeRadio" Content="Stały:" Margin="0,0,6,0" />
                <TextBox x:Name="SizeBox" Width="64" Padding="3,2" VerticalContentAlignment="Center" IsEnabled="False"
                         ToolTip="Wysokość czcionki w milimetrach (1–26), np. 5 albo 4,5. Strzałki ↑↓ zmieniają o 0,5 mm." />
                <TextBlock Text="mm" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- Suggestions under the focused text box -->
        <Popup x:Name="SuggestionPopup" Placement="Bottom" StaysOpen="True" AllowsTransparency="True"
               PopupAnimation="None" Focusable="False">
            <Border x:Name="SuggestionBorder" Background="White" BorderBrush="#FF7A7A7A" BorderThickness="1"
                    MaxWidth="760" Margin="0,0,6,6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" />
                </Border.Effect>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Background="#FFF3F3F3" Foreground="{StaticResource HintBrush}"
                               FontSize="11" Padding="8,3"
                               Text="↑ ↓ – wybierz z listy,  Enter / Tab – wstaw,  Esc – zamknij listę" />
                    <ListBox x:Name="SuggestionList" Focusable="False" BorderThickness="0" MaxHeight="420"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="Black" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="8,4">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#FFE5F1FB" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#FF0067C0" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Display}" FontSize="16" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Details}" FontSize="11" Opacity="0.75" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
