<Application x:Class="LabelPrinter.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="HintBrush" Color="#FF6B6B6B" />
        <SolidColorBrush x:Key="WarningBackground" Color="#FFFFF4CE" />
        <SolidColorBrush x:Key="WarningBorder" Color="#FFE3B341" />
    </Application.Resources>
</Application>
